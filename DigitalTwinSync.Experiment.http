@host = http://localhost:5078

GET {{host}}/health
Accept: application/json

###

GET {{host}}/api/experiment/defaults
Accept: application/json

###

GET {{host}}/api/experiment/run-default
Accept: application/json

###

POST {{host}}/api/experiment/run
Content-Type: application/json

{
  "runsPerScenario": 10000,
  "seed": 20260809,
  "probeIntervalMs": 5000,
  "minRoundTripMs": 20,
  "maxRoundTripMs": 100,
  "retryCount": 3
}

###

POST {{host}}/api/experiment/run.csv
Content-Type: application/json

{
  "runsPerScenario": 10000,
  "seed": 20260809,
  "probeIntervalMs": 5000,
  "minRoundTripMs": 20,
  "maxRoundTripMs": 100,
  "retryCount": 3
